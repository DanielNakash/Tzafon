# Automation credentials for the headless pipeline. COPY this file to `.env` (which is git-ignored)
# and fill in the token. Never commit `.env`.
#
# Why this exists: launchd background agents can't read the macOS login keychain where the
# interactive `claude` login stores its OAuth session, so headless groomer/builder runs would fail
# with "Not logged in". A long-lived token supplied here fixes that — it's tied to your Claude
# subscription (no separate API billing).
#
# Generate the token by running this once in an interactive terminal and following the browser flow:
#     claude setup-token
# Then paste the printed token below and save as `.env`:

export CLAUDE_CODE_OAUTH_TOKEN="paste-the-token-from-claude-setup-token-here"

# IMPORTANT: mint this token while logged in as the account that should own the pipeline — the
# token, not your interactive login, is what a launchd run authenticates and bills. Then pin it:
#     zsh feature-requests/scripts/pin-account.sh
# That records the token's fingerprint plus your current account uuid, and from then on every
# groomer/builder run verifies both and halts on any mismatch (see scripts/assert-account.sh).
