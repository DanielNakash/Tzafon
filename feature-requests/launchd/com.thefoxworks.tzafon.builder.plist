<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thefoxworks.tzafon.builder</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/danielnakash/LocalWorkshop/Tzafon/feature-requests/scripts/run-builder.sh</string>
  </array>

  <!-- Run once a day at 03:30. Deliberately off the :00 slot: the groomer runs hourly at
       :00, and the shared lock would make a 03:00 builder skip (lock-held) whenever the
       groomer holds the lock. :30 never coincides with an hourly groomer run. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/danielnakash/LocalWorkshop/Tzafon/feature-requests/logs/builder.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/danielnakash/LocalWorkshop/Tzafon/feature-requests/logs/builder.launchd.err</string>
</dict>
</plist>
