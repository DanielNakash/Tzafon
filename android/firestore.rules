rules_version = '2';

// Tzafon sync (M9b). Every document lives under the owning user's subtree
// (users/{uid}/...), so a user can read and write only their own data and
// nothing else. Deploy via the Firebase console (Firestore → Rules) or
// `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
